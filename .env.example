# Autonomous Academic Paper Radar - Environment Configuration

# Google Gemini API Key (Required for paper summarization & scoring)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Tunnel Token (Optional for local dev, required for HTTPS cloud deployment)
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here

# SQLite Database File Location (Mounted inside backend container)
DB_PATH=/data/radar.db

# MQTT Broker Address & Port
MQTT_BROKER=broker:1883

# Default Search Keywords (Comma separated)
DEFAULT_KEYWORDS=swarm robotics, decentralized control, drone vtol

# arXiv Scraper Cron Interval (e.g., @every 6h or 0 */6 * * *)
ARXIV_FETCH_INTERVAL=@every 6h

# Server Port
PORT=8080
